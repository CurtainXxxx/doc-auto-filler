[project]
requires = ["python-3.12"]
project_type = "web"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "projects/scripts/coze-preview-build.sh"]
run = ["bash", "projects/scripts/coze-preview-run.sh"]

[deploy]
build = ["bash", "projects/scripts/setup.sh"]
run = ["bash", "projects/scripts/http_run.sh", "-p", "5000"]
deps = ["git"]

[deploy.profile]
kind = "service"
flavor = "web"

[deploy.backend]
enabled = true

[subprojects]
path = ["projects"]