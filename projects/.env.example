# Copy to .env and configure any OpenAI-compatible model endpoint.
EXTERNAL_LLM_BASE_URL=https://api.deepseek.com/v1
EXTERNAL_LLM_MODEL=deepseek-chat
EXTERNAL_LLM_API_KEY=

# Optional paths (defaults: projects/ and projects/data/)
# APP_WORKSPACE=
# APP_DATA_DIR=
# APP_PUBLIC_URL=http://localhost:5000
STORAGE_BACKEND=local

# Optional, only used when STORAGE_BACKEND=s3
# S3_BUCKET_NAME=
# S3_ENDPOINT_URL=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional PostgreSQL history; otherwise in-memory (lost on restart)
# PGDATABASE_URL=postgresql://user:password@localhost:5432/doc_auto_filler
LOG_LEVEL=INFO
